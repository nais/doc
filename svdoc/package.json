		"@iconify/utils": "^3.1.3",
		"@lucide/svelte": "^1.72.0",
		"bits-ui": "^2.21.0",
		"front-matter": "^4.0.2",
		"gemoji": "^8.1.0",
		"marked": "^18.0.4",
