		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.0.0",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"eslint-plugin-unicorn": "^79.0.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
